<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the upstream Plugins\Sound.Flac sources for Android. Upstream is not modified. -->

  <PropertyGroup>
    <TargetFramework>$(AndroidTfm)</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>Sound.Flac</RootNamespace>
    <AssemblyName>Sound.Flac</AssemblyName>
    <DefineConstants>$(DefineConstants);OPENBVE_ANDROID</DefineConstants>
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(UpstreamSource)Plugins\Sound.Flac\**\*.cs" LinkBase="Sound.Flac" />
    <Compile Remove="$(UpstreamSource)Plugins\Sound.Flac\Properties\AssemblyInfo.cs" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenBve.Compat\OpenBve.Compat.csproj" />
    <ProjectReference Include="..\OpenBveApi.Android\OpenBveApi.Android.csproj" />
  </ItemGroup>

  <ItemGroup>

  </ItemGroup>

</Project>

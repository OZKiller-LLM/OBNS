<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds the upstream LibRender2 sources against the GLES shim.
    Nothing under ..\..\OpenBVE is modified: changed files are Android copies (Android/UpstreamPatches).
  -->

  <PropertyGroup>
    <TargetFramework>$(AndroidTfm)</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>LibRender2</RootNamespace>
    <AssemblyName>LibRender2</AssemblyName>
    <DefineConstants>$(DefineConstants);OPENBVE_ANDROID</DefineConstants>
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(UpstreamSource)LibRender2\**\*.cs" LinkBase="LibRender2" />
    <Compile Remove="$(UpstreamSource)LibRender2\Properties\AssemblyInfo.cs" />
    <!-- ANDROID PORT copies of upstream files (OpenBVE 1.14.1.2), compiled in their place; see Android/UpstreamPatches. -->
    <Compile Remove="$(UpstreamSource)LibRender2\BaseRenderer.cs" />
    <Compile Include="BaseRenderer.Android.cs" />
    <Compile Remove="$(UpstreamSource)LibRender2\Textures\TextureManager.cs" />
    <Compile Include="TextureManager.Android.cs" />
    <Compile Remove="$(UpstreamSource)LibRender2\Objects\ObjectLibrary.cs" />
    <Compile Include="ObjectLibrary.Android.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Upstream loads shaders from embedded resources named LibRender2.<name>.<ext>
      (AbstractShader, isFromStream: true), not from disk. The logical names must match exactly.
    -->
    <EmbeddedResource Include="$(UpstreamSource)..\assets\Shaders\*.vert" Exclude="$(UpstreamSource)..\assets\Shaders\default.vert" LogicalName="LibRender2.%(Filename).vert" />
    <EmbeddedResource Include="$(UpstreamSource)..\assets\Shaders\*.frag" Exclude="$(UpstreamSource)..\assets\Shaders\default.frag;$(UpstreamSource)..\assets\Shaders\rectangle.frag" LogicalName="LibRender2.%(Filename).frag" />
    <!-- ANDROID PORT copies of these upstream shaders (GLSL ES conversions); see Android/UpstreamPatches. -->
    <EmbeddedResource Include="Shaders\default.vert" LogicalName="LibRender2.default.vert" />
    <EmbeddedResource Include="Shaders\default.frag;Shaders\rectangle.frag" LogicalName="LibRender2.%(Filename).frag" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenBveApi.Android\OpenBveApi.Android.csproj" />
    <ProjectReference Include="..\OpenBve.Compat\OpenBve.Compat.csproj" />
    <ProjectReference Include="..\OpenBve.GLES\OpenBve.GLES.csproj" />
  </ItemGroup>

  <!--
    The Android renderer (OpenBve.Android) reads the texture transparency cache
    (TextureManager.textureCache) to batch static objects the way upstream classifies their faces.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="OpenBve.Android" />
  </ItemGroup>

</Project>

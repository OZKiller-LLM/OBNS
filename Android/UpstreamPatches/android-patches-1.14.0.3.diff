+		/// <summary>Reads until the buffer holds the requested number of bytes, or the stream ends</summary>
+		/// <remarks>
+		/// Stream.Read may legitimately return fewer bytes than requested even when more are to
+		/// come. The .NET Framework and Mono DeflateStream happened to fill the buffer in a single
+		/// call, but the modern .NET implementation does not, so a single call reports a truncated
+		/// scanline on every PNG.
+		/// </remarks>
+		/// <returns>The number of bytes read</returns>
+		private static int ReadFully(Stream stream, byte[] buffer, int count)
+		{
+			int total = 0;
+			while (total < count)
+			{
+				int read = stream.Read(buffer, total, count - total);
+				if (read == 0)
+				{
+					break;
+				}
+				total += read;
+			}
+			return total;
+		}

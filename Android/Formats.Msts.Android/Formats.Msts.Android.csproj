<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the upstream Plugins\Formats.Msts sources for Android. Upstream is not modified. -->

  <PropertyGroup>
    <TargetFramework>$(AndroidTfm)</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>Formats.Msts</RootNamespace>
    <AssemblyName>Formats.Msts</AssemblyName>
    <DefineConstants>$(DefineConstants);OPENBVE_ANDROID</DefineConstants>
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(UpstreamSource)Plugins\Formats.Msts\**\*.cs" LinkBase="Formats.Msts" />
    <Compile Remove="$(UpstreamSource)Plugins\Formats.Msts\Properties\AssemblyInfo.cs" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenBve.Compat\OpenBve.Compat.csproj" />
    <ProjectReference Include="..\OpenBveApi.Android\OpenBveApi.Android.csproj" />
  </ItemGroup>

  <ItemGroup>

  </ItemGroup>

</Project>

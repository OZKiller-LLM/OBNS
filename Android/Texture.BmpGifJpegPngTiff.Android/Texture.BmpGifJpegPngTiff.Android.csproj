<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the upstream Plugins\Texture.BmpGifJpegPngTiff sources for Android. Upstream is not modified. -->

  <PropertyGroup>
    <TargetFramework>$(AndroidTfm)</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>Texture.BmpGifJpegPngTiff</RootNamespace>
    <AssemblyName>Texture.BmpGifJpegPngTiff</AssemblyName>
    <DefineConstants>$(DefineConstants);OPENBVE_ANDROID</DefineConstants>
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(UpstreamSource)Plugins\Texture.BmpGifJpegPngTiff\**\*.cs" LinkBase="Texture.BmpGifJpegPngTiff" />
    <Compile Remove="$(UpstreamSource)Plugins\Texture.BmpGifJpegPngTiff\Properties\AssemblyInfo.cs" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenBve.Compat\OpenBve.Compat.csproj" />
    <ProjectReference Include="..\OpenBveApi.Android\OpenBveApi.Android.csproj" />
  </ItemGroup>

  <ItemGroup>

  </ItemGroup>

</Project>

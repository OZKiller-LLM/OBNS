<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="net.openbve">
	<uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />
	<uses-feature android:glEsVersion="0x00030000" android:required="true" />
	<!-- Vulkan is optional: without it the Vulkan backend falls back to OpenGL ES. -->
	<uses-feature android:name="android.hardware.vulkan.version" android:required="false" />
	<!--
	  Routes and trains are large folders the user keeps wherever they like, as on Windows, and the
	  file finder reads them in place. Android 11+ grants that as "all files access", which the user
	  allows on a system settings page; older versions use the storage permissions.
	-->
	<uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
	<application android:label="OpenBVE" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:allowBackup="false" android:hardwareAccelerated="true" android:requestLegacyExternalStorage="true" />
</manifest>

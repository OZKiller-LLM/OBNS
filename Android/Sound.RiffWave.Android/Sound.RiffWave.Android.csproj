<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the upstream Plugins\Sound.RiffWave sources for Android. Upstream is not modified. -->

  <PropertyGroup>
    <TargetFramework>$(AndroidTfm)</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>Sound.RiffWave</RootNamespace>
    <AssemblyName>Sound.RiffWave</AssemblyName>
    <DefineConstants>$(DefineConstants);OPENBVE_ANDROID</DefineConstants>
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(UpstreamSource)Plugins\Sound.RiffWave\**\*.cs" LinkBase="Sound.RiffWave" />
    <Compile Remove="$(UpstreamSource)Plugins\Sound.RiffWave\Properties\AssemblyInfo.cs" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenBve.Compat\OpenBve.Compat.csproj" />
    <ProjectReference Include="..\OpenBveApi.Android\OpenBveApi.Android.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="2.0.0" />
    <!-- WaveFormatConversionStream (Windows ACM): compiles everywhere, works on Windows only, as with NAudio 1.10 in 1.1. -->
    <PackageReference Include="NAudio.WinMM" Version="2.0.0" />
    <PackageReference Include="NLayer.NAudioSupport" Version="2.0.1" />
    <PackageReference Include="NLayer" Version="2.0.1" />
  </ItemGroup>

</Project>

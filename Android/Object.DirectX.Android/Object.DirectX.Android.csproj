<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the upstream Plugins\Object.DirectX sources for Android. Upstream is not modified. -->

  <PropertyGroup>
    <TargetFramework>$(AndroidTfm)</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>Object.DirectX</RootNamespace>
    <AssemblyName>Object.DirectX</AssemblyName>
    <DefineConstants>$(DefineConstants);OPENBVE_ANDROID</DefineConstants>
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(UpstreamSource)Plugins\Object.DirectX\**\*.cs" LinkBase="Object.DirectX" />
    <Compile Remove="$(UpstreamSource)Plugins\Object.DirectX\Properties\AssemblyInfo.cs" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssimpParser.Android\AssimpParser.Android.csproj" />
    <ProjectReference Include="..\OpenBve.Compat\OpenBve.Compat.csproj" />
    <ProjectReference Include="..\OpenBveApi.Android\OpenBveApi.Android.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetZip.OpenBVE" Version="1.17.2" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the upstream Plugins\Train.OpenBve sources for Android. Upstream is not modified. -->

  <PropertyGroup>
    <TargetFramework>$(AndroidTfm)</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>Train.OpenBve</RootNamespace>
    <AssemblyName>Train.OpenBve</AssemblyName>
    <DefineConstants>$(DefineConstants);OPENBVE_ANDROID</DefineConstants>
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
    <ObnsTrainPlugin>..\..\OBNS\overrides\source\Plugins\Train.OpenBve\</ObnsTrainPlugin>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(UpstreamSource)Plugins\Train.OpenBve\**\*.cs" LinkBase="Train.OpenBve" />
    <Compile Remove="$(UpstreamSource)Plugins\Train.OpenBve\Properties\AssemblyInfo.cs" />
    <!-- Port copies (see each file's header): statics filled in by a train load made [ThreadStatic]. -->
    <Compile Remove="$(UpstreamSource)Plugins\Train.OpenBve\Train\BVE\ExtensionsCfgParser.cs" />
    <Compile Remove="$(UpstreamSource)Plugins\Train.OpenBve\Train\XML\TrainXmlParser.cs" />
    <Compile Include="ExtensionsCfgParser.Android.cs" />
    <Compile Include="TrainXmlParser.Android.cs" />
    <!-- OBNS's copies, shared with the desktop build: BVE Trainsim 5 trains (OBNS/BVE5.md) and the [ThreadStatic] statics. -->
    <Compile Remove="$(UpstreamSource)Plugins\Train.OpenBve\Plugin.cs" />
    <Compile Remove="$(UpstreamSource)Plugins\Train.OpenBve\Panel\Panel2CfgParser.cs" />
    <Compile Remove="$(UpstreamSource)Plugins\Train.OpenBve\Train\BVE5\MotorSoundTable.cs" />
    <Compile Include="$(ObnsTrainPlugin)Plugin.cs" Link="OBNS\Plugin.cs" />
    <Compile Include="$(ObnsTrainPlugin)Panel\Panel2CfgParser.cs" Link="OBNS\Panel2CfgParser.cs" />
    <Compile Include="$(ObnsTrainPlugin)Train\BVE5\*.cs" LinkBase="OBNS\BVE5" />
    <!-- The app finds a BVE5 vehicle's safety plugin with OBNS's reader (NativePluginBridge.ResolvePlugin). -->
    <InternalsVisibleTo Include="OpenBve.Android" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Formats.OpenBve.Android\Formats.OpenBve.Android.csproj" />
    <ProjectReference Include="..\LibRender2.Android\LibRender2.Android.csproj" />
    <ProjectReference Include="..\OpenBve.Compat\OpenBve.Compat.csproj" />
    <ProjectReference Include="..\OpenBve.GLES\OpenBve.GLES.csproj" />
    <ProjectReference Include="..\OpenBve.OpenAL\OpenBve.OpenAL.csproj" />
    <ProjectReference Include="..\OpenBveApi.Android\OpenBveApi.Android.csproj" />
    <ProjectReference Include="..\SoundManager.Android\SoundManager.Android.csproj" />
    <ProjectReference Include="..\TrainManager.Android\TrainManager.Android.csproj" />
  </ItemGroup>

  <ItemGroup>

  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    An x86 (IA-32) interpreter with a PE loader and a small Win32 / C runtime environment, for
    running 32-bit Windows BVE ATS plugins where Windows cannot: on Android, and in the desktop
    build on Linux and macOS. Platform independent: this project (net10.0) is the Android app's
    and OpenBve.X86.Tests' library; the desktop build compiles the same files into its TrainManager
    (.NET Framework 4.8, see Compat.cs). Nothing here executes native code; the plugin's
    instructions are interpreted, and its only access to the outside world is through the
    functions in Win32Environment.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>OpenBve.X86</RootNamespace>
    <AssemblyName>OpenBve.X86</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>

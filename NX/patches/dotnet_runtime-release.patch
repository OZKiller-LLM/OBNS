diff --git a/src/mono/mono/utils/mono-mmap-libnx.c b/src/mono/mono/utils/mono-mmap-libnx.c
index c12809f52..2efd110aa 100644
--- a/src/mono/mono/utils/mono-mmap-libnx.c
+++ b/src/mono/mono/utils/mono-mmap-libnx.c
@@ -294,7 +294,24 @@ mono_valloc_aligned (size_t size, size_t alignment, int flags, MonoMemAccountTyp
 
 	void* ptr = NULL;
 	BEGIN_CRITICAL_SECTION;
-	ptr = alloc_range (size, page_alignment);
+	if (page_alignment) {
+		// OBNS: alloc_range aligns page indices from heap_start, which is aligned only as far as the heap's start
+		// happens to be (4 MB in one run, 8 in another): a larger nursery failed the check below. Allocate enough
+		// to hold an aligned block, keep that, and give back the pages before and after it.
+		size_t used = (size + MMAP_PAGE_SIZE - 1) / MMAP_PAGE_SIZE * MMAP_PAGE_SIZE;
+		size_t padded = used + alignment - MMAP_PAGE_SIZE;
+		char *raw = (char *)alloc_range (padded, 0);
+		if (raw) {
+			uintptr_t aligned = ((uintptr_t)raw + alignment - 1) & ~(uintptr_t)(alignment - 1);
+			size_t head = aligned - (uintptr_t)raw;
+			size_t tail = padded - head - used;
+			if (head) free_range (raw, head);
+			if (tail) free_range ((char *)aligned + used, tail);
+			ptr = (void *)aligned;
+		}
+	} else {
+		ptr = alloc_range (size, 0);
+	}
 	END_CRITICAL_SECTION;
 
 	if (!ptr) return NULL;

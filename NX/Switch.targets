<Project>

  <!--
    OBNS 1.32: builds the Android port's projects for the Switch without changing them. Imported into every project
    of a build through CustomAfterMicrosoftCommonTargets, with AndroidTfm set to the Switch runtime's framework:

      dotnet build <project> -p:AndroidTfm=net9.0 -p:ObnsX86Tfm=net9.0 -p:CustomAfterMicrosoftCommonTargets=<this file>

    It runs after each project's own items, so it can replace Android's OpenBve.Compat (Skia, which has no Switch build)
    with NX's (NX/OpenBve.Compat.NX), and drop the SkiaSharp packages.
  -->

  <PropertyGroup>
    <ObnsSwitch>true</ObnsSwitch>
    <!--
      C# 13, .NET 9's own: under C# 14 (the Android projects' "latest") upstream's byte[].Reverse() binds to
      MemoryExtensions.Reverse(Span), which returns nothing; .NET 10 added the array overload that keeps it working.
    -->
    <LangVersion>13</LangVersion>
    <DefineConstants>$(DefineConstants);OBNS_SWITCH</DefineConstants>
    <!--
      No PDBs (2026-11-08): a portable PDB records the identity of every assembly it references, and a deterministic
      build takes the assembly's own identity (MVID) from its PDB too - so a rebuilt dependency gave every parser a new
      identity with its code unchanged, and the object cache, which goes by the parsers' identities, started again after
      every build (13-minute loads of the Tuen Ma Line). Everything here is compiled ahead of time; nothing reads them.
    -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <_ObnsAndroidCompat Include="@(ProjectReference->WithMetadataValue('Filename', 'OpenBve.Compat'))" />
    <ProjectReference Remove="@(_ObnsAndroidCompat)" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)OpenBve.Compat.NX\OpenBve.Compat.NX.csproj" Condition="'@(_ObnsAndroidCompat)' != ''" />
    <PackageReference Remove="SkiaSharp" />
    <PackageReference Remove="SkiaSharp.NativeAssets.Android" />
  </ItemGroup>

  <!--
    The Android game project (Android/OpenBve.Android), the composition root: upstream's game files, OBNS's shared plugin
    layer and the Android host's loading code, compiled for the Switch as a library that NX/OpenBve.NX starts. The files
    that need Android's activity, views, settings, file system or ANGLE and Vulkan surfaces are left out; NX supplies
    what the rest needs from them (NX/OpenBve.NX/AndroidStandIns).
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'OpenBve.Android'">
    <OutputType>Library</OutputType>
    <!-- No Android runtimes: with them, Antlr4's .NET Standard 1.6 dependencies resolve as package downgrades. -->
    <RuntimeIdentifiers />
    <RuntimeIdentifier />
  </PropertyGroup>

  <!-- Until the deko3d renderer (step 3), OpenBve.NX sets up the renderer's parts that loading uses without OpenGL. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'LibRender2.Android'">
    <InternalsVisibleTo Include="OpenBve.NX" />
  </ItemGroup>

  <!--
    #11 stage 1 (OBNS/SWITCH.md): the meshes in deko3d's memory without GL calls. NX/LibRender2's copies of upstream's VAO,
    VBO and IBO (the same public face) hand their data to NativeMeshes.Device, which OpenBve.NX sets to DekoGL.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'LibRender2.Android'">
    <Compile Remove="$(UpstreamSource)LibRender2\openGL\VertexArrayObject.cs;$(UpstreamSource)LibRender2\openGL\VertexBufferObject.cs;$(UpstreamSource)LibRender2\openGL\IndexBufferObject.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)LibRender2\*.cs" LinkBase="NX" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'OpenBve.Android'">
    <Compile Remove="AngleSurface.cs;AndroidFileSystem.cs;AndroidSettings.cs;BetaLog.cs;ControlBindings.cs;ControlOverlay.cs;ControlsPage.cs;DriverHud.cs;FileBrowser.cs;GameActivity.cs;GameView.cs;KeyboardInput.cs;LaunchParameters.cs;Menu.cs;MenuActivity.cs;OptionsPage.cs;PerformanceHints.cs;PackagesPage.cs;PauseMenu.cs;RouteViews.cs;SceneInput.cs;Speech.cs;StartPage.cs;SwitchMapPanel.cs;TimetablePanel.cs;Ui.cs;VulkanStartup.cs;VulkanSurface.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Game\**\*.cs" LinkBase="NX" />
    <!-- The Switch entry (NX/OpenBve.NX) drives the game as GameView does, through its internal Program and Interface. -->
    <InternalsVisibleTo Include="OpenBve.NX" />
    <PackageReference Remove="MonoGame.Library.OpenAL" />
    <AndroidAsset Remove="@(AndroidAsset)" />
  </ItemGroup>

</Project>

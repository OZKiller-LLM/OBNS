<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OBNS 1.32: the Switch's entry program. It drives the Android port's game project (built for the Switch through
    NX/Switch.targets) as Android's GameView does. Built with NX/build-switch.ps1 (a compile check on Windows) or
    NX/build-nro.sh (on Linux: trimmed, compiled ahead of time with LLVM, linked with NX/runner into the NRO).
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>OpenBve.NX</AssemblyName>
    <RootNamespace>OpenBve.NX</RootNamespace>
    <LangVersion>13</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="libnx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Android\OpenBve.Android\OpenBve.Android.csproj" />
  </ItemGroup>

</Project>

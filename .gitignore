# Build outputs
bin/
obj/
.vs/
*.user
*.suo

# Release packages (Android/release.ps1) - published separately, not source
dist/

# Third-party routes and trains used for testing: their authors' terms forbid redistribution
/content/

# Upstream's own source archives (the tree is in OpenBVE/)
/src-*.zip

# Signing keys never belong in the repository
*.jks
*.keystore

# Device benchmark results (Android/tools/benchmark) - per-run output, not source
/Android/tools/benchmark/results/

# The OBNS desktop build mirror (OBNS/build-desktop.ps1)
/OBNS/build/

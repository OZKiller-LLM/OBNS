<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the upstream Plugins\Object.Msts sources for Android. Upstream is not modified. -->

  <PropertyGroup>
    <TargetFramework>$(AndroidTfm)</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>Object.Msts</RootNamespace>
    <AssemblyName>Object.Msts</AssemblyName>
    <DefineConstants>$(DefineConstants);OPENBVE_ANDROID</DefineConstants>
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(UpstreamSource)Plugins\Object.Msts\**\*.cs" LinkBase="Object.Msts" />
    <Compile Remove="$(UpstreamSource)Plugins\Object.Msts\Properties\AssemblyInfo.cs" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Formats.Msts.Android\Formats.Msts.Android.csproj" />
    <ProjectReference Include="..\OpenBve.Compat\OpenBve.Compat.csproj" />
    <ProjectReference Include="..\OpenBveApi.Android\OpenBveApi.Android.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

</Project>

<Project>

  <!--
    Shared settings for the Android port projects.
    The upstream OpenBVE sources are NOT modified: each project here is an
    SDK-style "shim" project that compiles the upstream .cs files with
    Android-appropriate references and a compatibility layer.
  -->

  <PropertyGroup>
    <UpstreamSource>$(MSBuildThisFileDirectory)..\OpenBVE-1.14.0.3\source\</UpstreamSource>
    <AndroidTfm>net10.0-android36.0</AndroidTfm>

    <!-- A Java 8 JRE sits on PATH ahead of the real JDKs; point the Android SDK at Android Studio's JBR. -->
    <JavaSdkDirectory Condition="Exists('$(ProgramFiles)\Android\Android Studio\jbr\bin\jar.exe')">$(ProgramFiles)\Android\Android Studio\jbr</JavaSdkDirectory>
    <AndroidSdkDirectory Condition="Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>

    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Upstream is a decade-old codebase: silence style/obsolete noise, keep real errors. -->
    <NoWarn>$(NoWarn);CS1591;CS0618;CS0612;CS0067;CS0649;CS0414;CS0169;CS0219;CA1416</NoWarn>
  </PropertyGroup>

</Project>

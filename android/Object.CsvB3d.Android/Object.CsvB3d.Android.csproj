<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the upstream Plugins\Object.CsvB3d sources for Android. Upstream is not modified. -->

  <PropertyGroup>
    <TargetFramework>$(AndroidTfm)</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>Object.CsvB3d</RootNamespace>
    <AssemblyName>Object.CsvB3d</AssemblyName>
    <DefineConstants>$(DefineConstants);OPENBVE_ANDROID</DefineConstants>
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(UpstreamSource)Plugins\Object.CsvB3d\**\*.cs" LinkBase="Object.CsvB3d" />
    <Compile Remove="$(UpstreamSource)Plugins\Object.CsvB3d\Properties\AssemblyInfo.cs" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Formats.OpenBve.Android\Formats.OpenBve.Android.csproj" />
    <ProjectReference Include="..\OpenBve.Compat\OpenBve.Compat.csproj" />
    <ProjectReference Include="..\OpenBveApi.Android\OpenBveApi.Android.csproj" />
  </ItemGroup>

  <ItemGroup>

  </ItemGroup>

</Project>

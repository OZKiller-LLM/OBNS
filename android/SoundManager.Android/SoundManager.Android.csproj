<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the upstream SoundManager sources for Android. Upstream is not modified. -->

  <PropertyGroup>
    <TargetFramework>$(AndroidTfm)</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>SoundManager</RootNamespace>
    <AssemblyName>SoundManager</AssemblyName>
    <DefineConstants>$(DefineConstants);OPENBVE_ANDROID</DefineConstants>
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(UpstreamSource)SoundManager\**\*.cs" LinkBase="SoundManager" />
    <Compile Remove="$(UpstreamSource)SoundManager\Properties\AssemblyInfo.cs" />
    <!-- Port copy with the cached file-existence check (see the file's header). -->
    <Compile Remove="$(UpstreamSource)SoundManager\Sounds.CarSound.cs" />
    <Compile Include="Sounds.CarSound.Android.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenBveApi.Android\OpenBveApi.Android.csproj" />
    <ProjectReference Include="..\OpenBve.Compat\OpenBve.Compat.csproj" />
    <ProjectReference Include="..\OpenBve.OpenAL\OpenBve.OpenAL.csproj" />
  </ItemGroup>

</Project>
